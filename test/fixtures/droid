#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import sys
import time

assert sys.argv[1:5] == ["computer", "ssh", "fake-mac", "--"]
print("Fetching computer info...\nConnecting to fake-mac...\nConnected", file=sys.stderr, flush=True)
if os.environ.get("FAKE_RELAY_MODE") == "hang":
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(120)"])
    Path(os.environ["FAKE_RELAY_PID"]).write_text(str(child.pid))
    time.sleep(120)
else:
    os.execv(str(Path(__file__).with_name("ssh")), ["ssh", sys.argv[5]])
